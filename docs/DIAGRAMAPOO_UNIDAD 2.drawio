        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass ContenidoAudiovisual {\n  &lt;&lt;abstract&gt;&gt;\n  -int id\n  -String titulo\n  -int duracionEnMinutos\n  -String genero\n  +getId() int\n  +getTitulo() String\n  +getDuracionEnMinutos() int\n  +getGenero() String\n  +mostrarDetalles() void\n}\n\nclass Pelicula {\n  -String estudio\n  -List~Actor~ actores\n  +agregarActor() void\n  +eliminarActor() void\n  +getActores() List~Actor~\n  +mostrarDetalles() void\n}\n\nclass SerieDeTV {\n  -List~Temporada~ listaTemporadas\n  +agregarTemporada() void\n  +eliminarTemporada() void\n  +getTemporadas() List~Temporada~\n  +mostrarDetalles() void\n}\n\nclass Documental {\n  -String tema\n  -List~Investigador~ investigadores\n  +agregarInvestigador() void\n  +eliminarInvestigador() void\n  +getInvestigadores() List~Investigador~\n  +mostrarDetalles() void\n}\n\nclass Actor {\n  -String nombre\n  -String nacionalidad\n  -int edad\n  +mostrarInformacion() void\n}\n\nclass Temporada {\n  -int numeroTemporada\n  -int anioEstreno\n  -int numeroEpisodios\n  +mostrarInformacion() void\n}\n\nclass Investigador {\n  -String nombre\n  -String especialidad\n  -String institucion\n  +mostrarInformacion() void\n}\n\nclass Podcast {\n  -String nombrePresentador\n  -String tematica\n  -int numeroEpisodios\n  -String plataforma\n  +publicarEpisodio() void\n  +mostrarTematica() void\n  +mostrarDetalles() void\n}\n\nclass CursoOnline {\n  -String instructor\n  -String areaConocimiento\n  -String nivel\n  -int numeroModulos\n  +mostrarContenido() void\n  +actualizarModulos(cantidad) void\n  +mostrarDetalles() void\n}\n\nContenidoAudiovisual &lt;|-- Pelicula\nContenidoAudiovisual &lt;|-- SerieDeTV\nContenidoAudiovisual &lt;|-- Documental\nContenidoAudiovisual &lt;|-- Podcast\nContenidoAudiovisual &lt;|-- CursoOnline\n\nPelicula \&quot;0..*\&quot; -- \&quot;0..*\&quot; Actor : asociacion\nSerieDeTV \&quot;1\&quot; *-- \&quot;0..*\&quot; Temporada : composicion\nDocumental \&quot;0..*\&quot; o-- \&quot;0..*\&quot; Investigador : agregacion\n\nclassDef padre fill:#DCEBFA,stroke:#245A81,stroke-width:3px,color:#17324D\nclassDef originales fill:#F3F0FA,stroke:#7963A8,stroke-width:2px,color:#35264F\nclassDef auxiliares fill:#FFF1D6,stroke:#B78328,stroke-width:2px,color:#60410D\nclassDef nuevas fill:#DDF3E4,stroke:#318253,stroke-width:2px,color:#174D2D\n\nclass ContenidoAudiovisual padre\nclass Pelicula,SerieDeTV,Documental originales\nclass Actor,Temporada,Investigador auxiliares\nclass Podcast,CursoOnline nuevas&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="t4rtcPDQP_m8KTshCQB9-1">
